{
  "name": "figma-jira-notifier",
  "version": "1.0.0",
  "description": "Monitors Figma files for changes and posts structured changelogs to linked Jira tickets.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "prestart": "npm run bundle",
    "start": "node src/server.js",
    "build": "npm run bundle && pkg . --out-path dist",
    "test": "jest --testPathPatterns=test/"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2"
  },
  "pkg": {
    "targets": [
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "assets": [
      "gui/**/*"
    ],
    "outputPath": "dist"
  }
}
